# ExcelPilot reads credentials from the process environment ONLY.
# There is deliberately no automatic .env loading (ADR-0002): a .env file in the
# working directory must not be able to silently redirect traffic or supply keys.
#
# Copy nothing. Export these in the shell that launches ExcelPilot:
#
#   export TYPESAFE_API_KEY=...      # or OPENROUTER_API_KEY, for JEV
#
# Neither key is required for inspection, planning, execution, or verification.
# They are only needed for live JEV decisions, and only with --allow-paid-calls.

# --- JEV (optional; advisory decisions only) ---
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

# --- LLM planning (optional; the deterministic planner is the default) ---
# Name of the variable holding the key, configured via model.api_key_env.
# The key value itself must never be written to a file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
